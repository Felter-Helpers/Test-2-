---
// Shared "Come see us" block that sends visitors to the physical shop.
import type { Site } from '../lib/site';

interface Props {
  visit: Site['visit'];
}
const { heading, text, linkLabel } = Astro.props.visit;
---

<section class="visit container" aria-labelledby="visit-heading">
  <div class="box">
    <h2 id="visit-heading">{heading}</h2>
    <p>{text}</p>
    <a class="button" href="/contact/">{linkLabel}</a>
  </div>
</section>

<style>
  .visit {
    margin-top: var(--space-2xl);
  }
  .box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-xl) var(--space-lg);
    border-radius: var(--radius);
    background: var(--color-bg-secondary);
    text-align: center;
  }
  h2 {
    font-size: var(--text-heading);
  }
  .button {
    width: 100%;
  }
  @media (min-width: 768px) {
    .button {
      width: auto;
    }
  }
</style>
