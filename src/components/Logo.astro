---
// Placeholder wordmark: a letter in the accent color. Replace with the client's logo.
interface Props {
  text: string;
  size?: number;
  label?: string;
}
const { text, size = 40, label } = Astro.props;
---

<svg
  class="logo"
  viewBox="0 0 64 64"
  width={size}
  height={size}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <rect x="2" y="2" width="60" height="60" rx="8" fill="none" stroke="currentColor" stroke-width="4"></rect>
  <text x="32" y="44" font-size="34" font-weight="600" text-anchor="middle" fill="currentColor" font-family="system-ui, sans-serif">{text}</text>
</svg>

<style>
  .logo {
    color: var(--color-accent);
    flex-shrink: 0;
  }
</style>
