---
// Click-to-load map: nothing is requested from Google until the visitor
// presses "Show map". Reuse this pattern for any other third-party embed.
import { addressLine, mapEmbedSrc, type Site } from '../lib/site';

interface Props {
  shop: Site['shop'];
  map: Site['map'];
}
const { shop, map } = Astro.props;
const address = addressLine(shop);
---

<section class="map" aria-label="Map">
  <div class="frame" data-src={mapEmbedSrc(shop)} data-title={`Map of ${shop.name}`}>
    <div class="placeholder">
      <svg viewBox="0 0 24 24" width="40" height="40" aria-hidden="true">
        <path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z" fill="none" stroke="currentColor" stroke-width="2"></path>
        <circle cx="12" cy="10" r="2.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
      </svg>
      <p class="address">{address}</p>
      <button class="button" type="button" aria-label={`${map.buttonLabel} for ${address}`}>{map.buttonLabel}</button>
      <p class="note">{map.consentNote}</p>
    </div>
  </div>
</section>

<script>
  for (const frame of document.querySelectorAll<HTMLElement>('.map .frame')) {
    frame.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = frame.dataset.src!;
      iframe.title = frame.dataset.title!;
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.allowFullscreen = true;
      frame.replaceChildren(iframe);
    });
  }
</script>

<style>
  .map {
    margin-top: var(--space-2xl);
  }
  .frame {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-bg-secondary);
    border: var(--border-width) solid var(--color-border);
  }
  .placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    height: 100%;
    padding: var(--space-lg);
    text-align: center;
    color: var(--color-text-secondary);
  }
  .address {
    color: var(--color-text-primary);
    font-size: var(--text-small);
  }
  .button {
    border: 0;
    cursor: pointer;
    font: inherit;
    font-weight: var(--font-weight-bold);
  }
  .note {
    max-width: 40ch;
    font-size: var(--text-small);
  }
  .frame :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  @media (min-width: 768px) {
    .frame {
      aspect-ratio: 16 / 9;
    }
  }
</style>
