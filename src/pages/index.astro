import Hero from '../components/Hero.astro';
import Testimonials from '../components/Testimonials.astro';
import { getSite } from '../lib/site';

const site = await getSite();
---

<BaseLayout>
  <Hero site={site} />
  <Testimonials testimonials={site.testimonials} />
</BaseLayout>
