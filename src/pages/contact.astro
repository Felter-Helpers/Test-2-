---
import BaseLayout from '../layouts/BaseLayout.astro';
import HoursTable from '../components/HoursTable.astro';
import ContactForm from '../components/ContactForm.astro';
import Map from '../components/Map.astro';
import { directionsHref, getSite, mailtoHref, telHref } from '../lib/site';

const site = await getSite();
const { shop, contact } = site;
const { street, city, region, postalCode } = shop.address;
---

<BaseLayout title="Contact & Hours" description={`Opening hours, address and contact details for ${shop.name}.`}>
  <div class="container page">
    <h1>{contact.heading}</h1>

    <div class="columns">
      <div class="info">
        <div class="actions">
          <a class="button" href={telHref(shop.phone)}>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
            </svg>
            {contact.callLabel} {shop.phone}
          </a>
          <a class="button" href={mailtoHref(shop.email)}>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="2"></rect>
              <path d="M3 7l9 6 9-6" fill="none" stroke="currentColor" stroke-width="2"></path>
            </svg>
            {contact.emailLabel}
          </a>
        </div>

        <div class="address">
          <address>
            <strong>{shop.name}</strong><br />
            {street}<br />
            {city}, {region} {postalCode}
          </address>
          <a href={directionsHref(shop)} target="_blank" rel="noopener">
            {contact.directionsLabel}
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        </div>

        <HoursTable
          hours={site.hours}
          heading={contact.hoursHeading}
          upcomingHeading={contact.upcomingHeading}
          upcomingDays={contact.upcomingDays}
        />
      </div>

      <ContactForm form={site.form} />
    </div>

    <Map shop={shop} map={site.map} />
  </div>
</BaseLayout>

<style>
  .page {
    padding-top: var(--space-xl);
  }
  h1 {
    font-size: var(--text-display);
    margin-bottom: var(--space-lg);
  }
  .columns {
    display: grid;
    gap: var(--space-2xl);
  }
  .info {
    display: grid;
    gap: var(--space-xl);
    align-content: start;
  }
  .actions {
    display: grid;
    gap: var(--space-md);
  }
  .actions .button {
    gap: var(--space-sm);
  }
  .address {
    display: grid;
    gap: var(--space-sm);
  }
  address {
    font-style: normal;
  }
  .address a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    justify-self: start;
    font-weight: var(--font-weight-bold);
  }
  @media (min-width: 768px) {
    .columns {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }
    .actions {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
