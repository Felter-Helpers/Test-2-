---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import VisitUs from '../components/VisitUs.astro';
import { getSite, photo } from '../lib/site';

const site = await getSite();
const about = site.about;
const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((part) => part[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
---

<BaseLayout title="About" description={about.story[0]}>
  <div class="container page">
    <h1>{about.heading}</h1>

    <section class="story">
      <Image
        src={photo(about.photo)}
        alt={about.photoAlt}
        widths={[480, 800, 1200]}
        sizes="(min-width: 768px) 50vw, 100vw"
        loading="eager"
        class="story-photo"
      />
      <div class="story-text">
        {about.story.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    {
      about.facts.length > 0 && (
        <section class="facts" aria-labelledby="facts-heading">
          <h2 id="facts-heading">{about.factsHeading}</h2>
          <dl>
            {about.facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {
      about.team.length > 0 && (
        <section class="team" aria-labelledby="team-heading">
          <h2 id="team-heading">{about.teamHeading}</h2>
          <ul role="list">
            {about.team.map((person) => (
              <li class="person">
                {person.photo ? (
                  <Image src={photo(person.photo)} alt={person.photoAlt!} widths={[96, 192]} sizes="96px" class="avatar" />
                ) : (
                  <span class="avatar avatar--initials" aria-hidden="true">
                    {initials(person.name)}
                  </span>
                )}
                <div>
                  <p class="name">{person.name}</p>
                  <p class="role">{person.role}</p>
                  <p>{person.bio}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>

  <VisitUs visit={site.visit} />
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: var(--space-2xl);
    padding-top: var(--space-xl);
  }
  h1 {
    font-size: var(--text-display);
    margin-bottom: calc(-1 * var(--space-lg));
  }
  h2 {
    font-size: var(--text-heading);
    margin-bottom: var(--space-md);
  }
  .story {
    display: grid;
    gap: var(--space-lg);
    align-items: start;
  }
  .story-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--color-bg-secondary);
  }
  .story-text {
    display: grid;
    gap: var(--space-md);
    max-width: 60ch;
  }
  .facts dl {
    display: grid;
    gap: var(--space-md);
    margin: 0;
  }
  .facts dl div {
    padding: var(--space-md) var(--space-lg);
    border-left: 3px solid var(--color-accent);
    background: var(--color-bg-secondary);
  }
  .facts dt {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }
  .facts dd {
    margin: 0;
    font-weight: var(--font-weight-bold);
  }
  .team ul {
    display: grid;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .person {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }
  .avatar {
    flex-shrink: 0;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
  }
  .avatar--initials {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-secondary);
    border: var(--border-width) solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: var(--text-heading);
    font-weight: var(--font-weight-bold);
  }
  .name {
    font-weight: var(--font-weight-bold);
  }
  .role {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-xs);
  }
  @media (min-width: 768px) {
    .story {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }
    .facts dl {
      grid-template-columns: repeat(3, 1fr);
    }
    .team ul {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
