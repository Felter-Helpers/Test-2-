---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NoticeBanner from '../components/NoticeBanner.astro';
import { getSite } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}
const site = await getSite();
const { title, description = site.shop.description } = Astro.props;
const fullTitle = title ? `${title} | ${site.shop.name}` : site.shop.name;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <NoticeBanner banner={site.banner} />
    <Header shopName={site.shop.name} logoText={site.shop.logoText} />
    <main>
      <slot />
    </main>
    <Footer shop={site.shop} />
  </body>
</html>
